rules_version = '2';

// Everything a user owns lives under /users/{uid}/... so the rule is simple:
// you may only read/write your own subtree. Templates are public read-only.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /cvs/{cvId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /exportLog/{day} {
        // Reads allowed so the UI can show remaining quota.
        // Writes only ever happen via the increment transaction on the client
        // acting as the signed-in user themselves — still limited to their own doc.
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /templates/{templateId} {
      allow read: if true;
      allow write: if false; // seed/manage templates via the Firebase console or an admin script
    }
  }
}
